# Database Configuration
DATABASE_URL=postgresql://username@localhost:5432/rtilens

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Backboard.io Configuration (Optional)
# Get your API key from https://backboard.io
BACKBOARD_API_KEY=your_backboard_api_key_here
BACKBOARD_ENABLED=true

# Search Configuration
BM25_WEIGHT=0.4
SEMANTIC_WEIGHT=0.6
MONGODB_VECTOR_INDEX=vector_index
MONGODB_VECTOR_CANDIDATES=100

# Rate Limiting
RATE_LIMIT=10/minute
MAX_QA_CALLS_PER_SESSION=10
