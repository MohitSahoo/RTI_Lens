# Database Configuration
DATABASE_URL=postgresql://username@localhost:5432/rtilens

# API Keys
OPENAI_API_KEY=sk-your-openai-key-here
GROQ_API_KEY=your-groq-key-here
GROQ_API_KEY_1=your-groq-key-1-here
GROQ_API_KEY_2=your-groq-key-2-here
GROQ_API_KEY_3=your-groq-key-3-here
BACKBOARD_API_KEY=your-backboard-key-here
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# MongoDB Vector Store
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=rtilens_vectors
MONGODB_COLLECTION=document_embeddings
MONGODB_VECTOR_INDEX=vector_index
MONGODB_VECTOR_CANDIDATES=100

# Solana Blockchain Configuration
# Use devnet for testing: https://api.devnet.solana.com
# Use mainnet for production: https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana Private Key (JSON array format from Phantom wallet export)
# Example: [123,45,67,89,...]
# Leave empty to run in simulation mode (no real transactions)
SOLANA_PRIVATE_KEY=

# Server Settings
API_HOST=0.0.0.0
API_PORT=8002
